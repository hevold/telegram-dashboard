# Kopier denne filen til .env og fyll inn verdiene

# Database (standard er SQLite for lokal utvikling)
DATABASE_URL=sqlite+aiosqlite:///./dashboard.db

# Telegram API (hentes fra https://my.telegram.org)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=din_api_hash_her
TELEGRAM_PHONE=+4712345678

# GDELT
GDELT_FETCH_INTERVAL_MINUTES=15

# IP-hviteliste (kommaseparert liste med IP-adresser og/eller CIDR-subnett)
# Eksempel: ALLOWED_IPS=192.168.1.10,10.0.0.0/8
# Tom verdi (standard) betyr at alle IP-adresser er tillatt.
ALLOWED_IPS=

# Sett til true kun når backend kjøres bak en omvendt proxy (f.eks. Nginx)
# som videresender ekte klient-IP i X-Forwarded-For-headeren.
# La stå false for å unngå IP-forfalskning.
TRUST_FORWARDED_FOR=false
